{
  "name": "snitinkumar-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write src scripts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env.local scripts/db/migrate.mjs",
    "db:create-admin": "node --env-file=.env.local scripts/db/create-admin.mjs",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local scripts/db/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@supabase/supabase-js": "^2.117.2",
    "firebase": "^12.19.0",
    "jose": "^6.2.12",
    "next": "16.3.6",
    "papaparse": "^5.7.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "opentype.js": "^1.3.4",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
