# Public site URL used for canonical links and WhatsApp/OG preview images.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://example.com

# 32+ random characters. Required in production (signs the session cookie).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shows the "Preview as: Guest / Pending / Approved" bar on a deployed preview so price
# gating can be reviewed before real login exists. Leave unset for the live site.
# ENABLE_DEMO_ROLES=true

# Supabase — server-only, never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Only for running migrations locally (Project Settings → Database → Session pooler).
# Not needed on Vercel.
DATABASE_URL=

# Firebase phone OTP (public web config; no service account needed).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
